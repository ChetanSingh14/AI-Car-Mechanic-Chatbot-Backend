DEBUG=True
SECRET_KEY=your_django_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Primary Multimodal AI (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-flash-latest

# Secondary AI Fallback (xAI Grok API - invoked if Gemini is unavailable or hits rate limit)
GROK_API_KEY=your_grok_xai_api_key_here
GROK_MODELS=grok-2-latest,grok-2,grok-beta

# Optional Throttling & Security Flags
# ENABLE_HTTPS=False
# DRF_THROTTLE_CHAT=40/min
# DRF_THROTTLE_UPLOAD=20/min
# DRF_THROTTLE_DIAGNOSIS=20/min
